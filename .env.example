# Project
COMPOSE_PROJECT_NAME=quan_ly_hoc_tap

# PostgreSQL
POSTGRES_USER=studyflow
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=studyflow_dev
POSTGRES_PORT=55432
DATABASE_URL=postgresql://studyflow:change_me_strong_password@localhost:55432/studyflow_dev?schema=public
DIRECT_URL=postgresql://studyflow:change_me_strong_password@localhost:55432/studyflow_dev?schema=public

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
# Vercel/Upstash: rediss://default:<password>@<database>.upstash.io:6379
REDIS_URL=redis://:change_me_redis_password@localhost:6379

# Backend
NODE_ENV=development
BACKEND_PORT=4000
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_SECRET=replace_with_a_long_random_access_secret
REFRESH_TOKEN_SECRET=replace_with_a_long_random_refresh_secret
CLIENT_ORIGIN=http://localhost:3000
TRUST_PROXY=false
# Random value of at least 16 characters; 32+ is recommended.
CRON_SECRET=replace_with_a_random_cron_secret
DOCUMENT_MAX_UPLOAD_BYTES=20971520
STORAGE_PROVIDER=local
S3_ENDPOINT=https://object-storage.example.com
S3_REGION=auto
S3_BUCKET=studyflow
S3_ACCESS_KEY_ID=replace_with_storage_access_key
S3_SECRET_ACCESS_KEY=replace_with_storage_secret_key
S3_PUBLIC_BASE_URL=https://cdn.example.com
S3_FORCE_PATH_STYLE=false
AI_PROVIDER=mock
VITE_API_URL=/api
VITE_APP_NAME=StudyFlow
VITE_VERCEL_ENV=development
VITE_AI_ENABLED=false
VITE_AI_PROVIDER=mock
# pgAdmin, enabled with: docker compose --profile tools up -d pgadmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin_password
PGADMIN_PORT=5050
