# Project
COMPOSE_PROJECT_NAME=quan_ly_hoc_tap

# PostgreSQL
POSTGRES_USER=studyflow
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=studyflow_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://studyflow:change_me_strong_password@localhost:5432/studyflow_dev?schema=public

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@localhost:6379

# pgAdmin, enabled with: docker compose --profile tools up -d pgadmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin_password
PGADMIN_PORT=5050

