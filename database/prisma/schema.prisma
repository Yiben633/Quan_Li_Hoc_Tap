generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ThemeMode {
  light
  dark

  @@map("theme_mode")
}

enum SemesterStatus {
  planning
  active
  closed
  archived

  @@map("semester_status")
}

enum SubjectStatus {
  in_progress
  completed
  dropped
  archived

  @@map("subject_status")
}

enum Priority {
  low
  medium
  high
  urgent

  @@map("priority")
}

enum StudyPlanStatus {
  not_started
  in_progress
  paused
  completed
  overdue

  @@map("study_plan_status")
}

enum TaskStatus {
  todo
  in_progress
  waiting
  done

  @@map("task_status")
}

enum ScheduleType {
  class
  self_study
  exam
  presentation
  group_work
  personal

  @@map("schedule_type")
}

enum RecurrenceRule {
  none
  daily
  weekly

  @@map("recurrence_rule")
}

enum GoalType {
  score
  study_time
  task_count
  course_completion
  gpa

  @@map("goal_type")
}

enum GoalStatus {
  in_progress
  achieved
  failed
  archived

  @@map("goal_status")
}

enum PomodoroSessionType {
  focus
  short_break
  long_break

  @@map("pomodoro_session_type")
}

enum DocumentFileType {
  pdf
  word
  excel
  ppt
  image
  link
  video
  code
  other

  @@map("document_file_type")
}

enum StorageProvider {
  local
  s3
  cloudinary
  minio

  @@map("storage_provider")
}

enum NotificationType {
  deadline_soon
  task_overdue
  class_soon
  exam_soon
  plan_incomplete
  goal_at_risk
  goal_achieved
  system

  @@map("notification_type")
}

enum NotificationChannel {
  in_app
  email
  push

  @@map("notification_channel")
}

enum GroupMemberRole {
  leader
  member

  @@map("group_member_role")
}

enum GroupMemberStatus {
  pending
  accepted
  rejected

  @@map("group_member_status")
}

enum FeedbackType {
  bug
  feature_request
  question

  @@map("feedback_type")
}

enum FeedbackStatus {
  open
  in_progress
  resolved
  closed

  @@map("feedback_status")
}

enum AiConversationStatus {
  active
  archived

  @@map("ai_conversation_status")
}

enum AiMessageRole {
  user
  assistant
  system
  tool

  @@map("ai_message_role")
}

enum AiPlanDraftStatus {
  draft
  applied
  discarded
  expired

  @@map("ai_plan_draft_status")
}

model User {
  id               String         @id @default(uuid()) @db.Uuid
  fullName         String         @map("full_name")
  email            String         @unique
  studentCode      String?        @unique @map("student_code")
  passwordHash     String         @map("password_hash")
  avatarUrl        String?        @map("avatar_url")
  school           String?
  major            String?
  courseYear       Int?           @map("course_year")
  timezone         String         @default("Asia/Ho_Chi_Minh")
  language         String         @default("vi")
  themeMode        ThemeMode      @default(light) @map("theme_mode")
  isEmailVerified  Boolean        @default(false) @map("is_email_verified")
  failedLoginCount Int            @default(0) @map("failed_login_count")
  lockedUntil      DateTime?      @map("locked_until")
  deletedAt        DateTime?      @map("deleted_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  roles            UserRole[]
  refreshTokens    RefreshToken[]
  semesters        Semester[]
  subjects         Subject[]
  studyPlans       StudyPlan[]
  tasks            Task[]
  schedules        Schedule[]
  events           Event[]
  goals            Goal[]
  studySessions    StudySession[]
  documents        Document[]
  notes            Note[]
  notifications    Notification[]
  notificationSetting NotificationSetting?
  flashcardSets    FlashcardSet[]
  ownedStudyGroups StudyGroup[]   @relation("StudyGroupOwner")
  groupMemberships GroupMember[]
  assignedGroupTasks GroupTask[]  @relation("GroupTaskAssignee")
  feedbacks        Feedback[]
  activityLogs     ActivityLog[]
  aiConversations  AiConversation[]
  aiPlanDrafts     AiPlanDraft[]
  studyPlanningPreference StudyPlanningPreference?

  @@index([email])
  @@index([studentCode])
  @@index([deletedAt])
  @@map("users")
}

/// Semesters use soft delete through deletedAt so historical study data can be restored
/// and dashboard/statistics can avoid accidental data loss.
model Semester {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  name            String
  academicYear    String         @map("academic_year")
  startDate       DateTime       @map("start_date") @db.Date
  endDate         DateTime       @map("end_date") @db.Date
  status          SemesterStatus @default(planning)
  targetGpa       Decimal?       @map("target_gpa") @db.Decimal(4, 2)
  expectedCredits Int?           @map("expected_credits")
  note            String?
  deletedAt       DateTime?      @map("deleted_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects        Subject[]

  @@unique([id, userId])
  @@index([userId, status])
  @@index([userId, deletedAt])
  @@map("semesters")
}

model StudyPlan {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  subjectId       String?         @map("subject_id") @db.Uuid
  title           String
  description     String?
  startDate       DateTime?       @map("start_date") @db.Date
  endDate         DateTime?       @map("end_date") @db.Date
  targetGoal      String?         @map("target_goal")
  estimatedHours  Decimal?        @map("estimated_hours") @db.Decimal(6, 2)
  priority        Priority        @default(medium)
  status          StudyPlanStatus @default(not_started)
  progressPercent Int             @default(0) @map("progress_percent")
  deletedAt       DateTime?       @map("deleted_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject         Subject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  tasks           Task[]

  @@index([userId, status])
  @@index([subjectId, status])
  @@index([userId, priority])
  @@index([userId, deletedAt])
  @@map("study_plans")
}

model Task {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  studyPlanId      String?          @map("study_plan_id") @db.Uuid
  subjectId        String?          @map("subject_id") @db.Uuid
  title            String
  description      String?
  startDate        DateTime?        @map("start_date") @db.Date
  dueDate          DateTime?        @map("due_date")
  estimatedMinutes Int?             @map("estimated_minutes")
  difficulty       Int?
  priority         Priority         @default(medium)
  status           TaskStatus       @default(todo)
  sortOrder        Int              @default(0) @map("sort_order")
  completedAt      DateTime?        @map("completed_at")
  deletedAt        DateTime?        @map("deleted_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyPlan        StudyPlan?       @relation(fields: [studyPlanId], references: [id], onDelete: SetNull)
  subject          Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subTasks         SubTask[]
  attachments      TaskAttachment[]
  documents        Document[]
  notes            Note[]

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([studyPlanId, status])
  @@index([subjectId, status])
  @@index([userId, priority, dueDate])
  @@index([userId, deletedAt])
  @@map("tasks")
}

model SubTask {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  title     String
  isDone    Boolean  @default(false) @map("is_done")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, sortOrder])
  @@map("sub_tasks")
}

model TaskAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  fileUrl   String   @map("file_url")
  fileName  String   @map("file_name")
  fileType  String?  @map("file_type")
  sizeBytes Int?     @map("size_bytes")
  createdAt DateTime @default(now()) @map("created_at")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_attachments")
}

/// Subjects also use soft delete through deletedAt. The database migration adds a
/// partial unique index so a user cannot reuse the same subject code in one semester
/// while an active, non-deleted subject with that code still exists.
model Subject {
  id          String        @id @default(uuid()) @db.Uuid
  semesterId  String        @map("semester_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  code        String
  name        String
  credits     Int
  lecturer    String?
  room        String?
  colorHex    String        @map("color_hex")
  targetGrade Decimal?      @map("target_grade") @db.Decimal(4, 2)
  status      SubjectStatus @default(in_progress)
  note        String?
  deletedAt   DateTime?     @map("deleted_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  semester    Semester      @relation(fields: [semesterId, userId], references: [id, userId], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyPlans  StudyPlan[]
  tasks       Task[]
  schedules   Schedule[]
  goals       Goal[]
  gradeComponents GradeComponent[]
  studySessions   StudySession[]
  documents       Document[]
  notes           Note[]
  flashcardSets   FlashcardSet[]

  @@index([userId, status])
  @@index([semesterId, status])
  @@index([userId, deletedAt])
  @@map("subjects")
}

model GradeComponent {
  id            String   @id @default(uuid()) @db.Uuid
  subjectId     String   @map("subject_id") @db.Uuid
  name          String
  maxScore      Decimal  @default(10) @map("max_score") @db.Decimal(5, 2)
  weightPercent Decimal  @map("weight_percent") @db.Decimal(5, 2)
  examDate      DateTime? @map("exam_date") @db.Date
  note          String?
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  grade         Grade?

  @@index([subjectId, sortOrder])
  @@map("grade_components")
}

/// The required final exam score is calculated in the backend, not persisted here.
/// Formula:
/// (targetGrade * totalWeight - SUM(scoredScore * scoredWeight)) / remainingWeight.
model Grade {
  id               String         @id @default(uuid()) @db.Uuid
  gradeComponentId String         @unique @map("grade_component_id") @db.Uuid
  score            Decimal?       @db.Decimal(5, 2)
  gradedAt         DateTime?      @map("graded_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  gradeComponent   GradeComponent @relation(fields: [gradeComponentId], references: [id], onDelete: Cascade)

  @@map("grades")
}

model StudySession {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  subjectId        String?           @map("subject_id") @db.Uuid
  startedAt        DateTime          @map("started_at")
  endedAt          DateTime?         @map("ended_at")
  totalMinutes     Int               @default(0) @map("total_minutes")
  note             String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject          Subject?          @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  pomodoroSessions PomodoroSession[]

  @@index([userId, startedAt])
  @@index([subjectId, startedAt])
  @@map("study_sessions")
}

model PomodoroSession {
  id             String              @id @default(uuid()) @db.Uuid
  studySessionId String              @map("study_session_id") @db.Uuid
  sessionType    PomodoroSessionType @map("session_type")
  plannedMinutes Int                 @map("planned_minutes")
  actualMinutes  Int?                @map("actual_minutes")
  startedAt      DateTime            @map("started_at")
  endedAt        DateTime?           @map("ended_at")
  isCompleted    Boolean             @default(false) @map("is_completed")
  studySession   StudySession        @relation(fields: [studySessionId], references: [id], onDelete: Cascade)

  @@index([studySessionId, startedAt])
  @@map("pomodoro_sessions")
}

/// Documents only store file metadata. File size, MIME type, virus checks and
/// storage authorization are enforced in the backend upload pipeline.
model Document {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  subjectId       String?          @map("subject_id") @db.Uuid
  taskId          String?          @map("task_id") @db.Uuid
  title           String
  fileUrl         String           @map("file_url")
  fileType        DocumentFileType @map("file_type")
  storageProvider StorageProvider  @map("storage_provider")
  sizeBytes       Int?             @map("size_bytes")
  tags            String[]         @default([])
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject         Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  task            Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, subjectId])
  @@index([userId, taskId])
  @@index([userId, deletedAt])
  @@map("documents")
}

model Note {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  subjectId       String?   @map("subject_id") @db.Uuid
  taskId          String?   @map("task_id") @db.Uuid
  title           String
  contentRichText String    @map("content_rich_text")
  isPinned        Boolean   @default(false) @map("is_pinned")
  tags            String[]  @default([])
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject         Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  task            Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, isPinned])
  @@index([userId, subjectId])
  @@index([userId, taskId])
  @@index([userId, deletedAt])
  @@map("notes")
}

model Schedule {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  subjectId       String?        @map("subject_id") @db.Uuid
  type            ScheduleType
  title           String
  dayOfWeek       Int?           @map("day_of_week")
  startTime       String         @map("start_time")
  endTime         String         @map("end_time")
  startDate       DateTime       @map("start_date") @db.Date
  endDate         DateTime?      @map("end_date") @db.Date
  recurrenceRule  RecurrenceRule @default(none) @map("recurrence_rule")
  colorHex        String?        @map("color_hex")
  reminderBefore  Int?           @map("reminder_before")
  deletedAt       DateTime?      @map("deleted_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject         Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, startDate])
  @@index([userId, deletedAt])
  @@index([subjectId])
  @@map("schedules")
}

model Event {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  title          String
  description    String?
  startAt        DateTime  @map("start_at")
  endAt          DateTime? @map("end_at")
  isAllDay       Boolean   @default(false) @map("is_all_day")
  colorHex       String?   @map("color_hex")
  reminderBefore Int?      @map("reminder_before")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startAt])
  @@index([userId, deletedAt])
  @@map("events")
}

/// Goal progress is intentionally not stored as progressPercent. The backend computes
/// it from targetValue/currentValue or domain data such as study sessions, tasks,
/// grades and GPA depending on Goal.type.
model Goal {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  subjectId    String?    @map("subject_id") @db.Uuid
  name         String
  type         GoalType
  targetValue  Decimal    @map("target_value") @db.Decimal(10, 2)
  currentValue Decimal    @default(0) @map("current_value") @db.Decimal(10, 2)
  deadline     DateTime?  @db.Date
  status       GoalStatus @default(in_progress)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject      Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([subjectId, status])
  @@index([userId, deadline])
  @@map("goals")
}

model Notification {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @map("user_id") @db.Uuid
  type              NotificationType
  title             String
  message           String
  relatedEntityType String?             @map("related_entity_type")
  relatedEntityId   String?             @map("related_entity_id") @db.Uuid
  isRead            Boolean             @default(false) @map("is_read")
  channel           NotificationChannel @default(in_app)
  sentAt            DateTime?           @map("sent_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model NotificationSetting {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @map("user_id") @db.Uuid
  reminderMinutesBefore Int      @default(60) @map("reminder_minutes_before")
  emailEnabled          Boolean  @default(false) @map("email_enabled")
  pushEnabled           Boolean  @default(false) @map("push_enabled")
  inAppEnabled          Boolean  @default(true) @map("in_app_enabled")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model FlashcardSet {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  subjectId   String?     @map("subject_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  flashcards  Flashcard[]

  @@index([userId])
  @@index([subjectId])
  @@map("flashcard_sets")
}

model Flashcard {
  id             String       @id @default(uuid()) @db.Uuid
  flashcardSetId String       @map("flashcard_set_id") @db.Uuid
  question       String
  answer         String
  isDifficult    Boolean      @default(false) @map("is_difficult")
  correctCount   Int          @default(0) @map("correct_count")
  wrongCount     Int          @default(0) @map("wrong_count")
  nextReviewAt   DateTime?    @map("next_review_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  flashcardSet   FlashcardSet @relation(fields: [flashcardSetId], references: [id], onDelete: Cascade)

  @@index([flashcardSetId])
  @@index([nextReviewAt])
  @@map("flashcards")
}

model StudyGroup {
  id          String        @id @default(uuid()) @db.Uuid
  ownerId     String        @map("owner_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  owner       User          @relation("StudyGroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     GroupMember[]
  tasks       GroupTask[]

  @@index([ownerId])
  @@map("study_groups")
}

model GroupMember {
  id           String            @id @default(uuid()) @db.Uuid
  studyGroupId String            @map("study_group_id") @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  role         GroupMemberRole   @default(member)
  status       GroupMemberStatus @default(pending)
  joinedAt     DateTime?         @map("joined_at")
  studyGroup   StudyGroup        @relation(fields: [studyGroupId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([studyGroupId, userId])
  @@index([userId, status])
  @@map("group_members")
}

model GroupTask {
  id             String      @id @default(uuid()) @db.Uuid
  studyGroupId   String      @map("study_group_id") @db.Uuid
  assignedUserId String?     @map("assigned_user_id") @db.Uuid
  title          String
  description    String?
  dueDate        DateTime?   @map("due_date")
  status         TaskStatus  @default(todo)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  studyGroup     StudyGroup  @relation(fields: [studyGroupId], references: [id], onDelete: Cascade)
  assignedUser   User?       @relation("GroupTaskAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([studyGroupId, status])
  @@index([assignedUserId, status])
  @@index([dueDate])
  @@map("group_tasks")
}

model Feedback {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  type       FeedbackType
  title      String
  content    String
  status     FeedbackStatus @default(open)
  adminReply String?        @map("admin_reply")
  createdAt  DateTime       @default(now()) @map("created_at")
  resolvedAt DateTime?      @map("resolved_at")
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("feedbacks")
}

model ActivityLog {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  action     String
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id") @db.Uuid
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  metadata   Json?
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@map("activity_logs")
}

/// Stores user-visible conversation state only. Provider prompts, hidden reasoning,
/// and credentials must never be persisted here.
model AiConversation {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  title     String?
  status    AiConversationStatus @default(active)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]
  drafts    AiPlanDraft[]

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

/// Metadata is limited to application state such as provider/model identifiers,
/// tool outcomes, and draft references. It must not contain hidden reasoning.
model AiMessage {
  id             String         @id @default(uuid()) @db.Uuid
  conversationId String         @map("conversation_id") @db.Uuid
  role           AiMessageRole
  content        String
  metadata       Json?
  createdAt      DateTime       @default(now()) @map("created_at")
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

/// A plan draft is inert until a user explicitly applies it. Applied drafts are
/// retained after a conversation is deleted for auditability via status/appliedAt.
model AiPlanDraft {
  id             String            @id @default(uuid()) @db.Uuid
  conversationId String?           @map("conversation_id") @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  draftType      String            @map("draft_type")
  status         AiPlanDraftStatus @default(draft)
  payload        Json
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  appliedAt      DateTime?         @map("applied_at")
  conversation   AiConversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([conversationId])
  @@map("ai_plan_drafts")
}

/// Per-user defaults used by the deterministic AI Coach planning engine. Time
/// boundaries stay optional so the engine can use its safe availability defaults.
model StudyPlanningPreference {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @map("user_id") @db.Uuid
  timezone              String   @default("Asia/Ho_Chi_Minh")
  preferredStudyStart   String?  @map("preferred_study_start")
  preferredStudyEnd     String?  @map("preferred_study_end")
  maxStudyMinutesPerDay Int      @default(180) @map("max_study_minutes_per_day")
  defaultSessionMinutes Int      @default(45) @map("default_session_minutes")
  minBreakMinutes       Int      @default(10) @map("min_break_minutes")
  allowWeekend          Boolean  @default(true) @map("allow_weekend")
  preferredDays         Int[]    @default([0, 1, 2, 3, 4, 5, 6]) @map("preferred_days")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("study_planning_preferences")
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
