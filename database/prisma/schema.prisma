generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ThemeMode {
  light
  dark

  @@map("theme_mode")
}

enum SemesterStatus {
  planning
  active
  closed
  archived

  @@map("semester_status")
}

enum SubjectStatus {
  in_progress
  completed
  dropped
  archived

  @@map("subject_status")
}

model User {
  id               String         @id @default(uuid()) @db.Uuid
  fullName         String         @map("full_name")
  email            String         @unique
  studentCode      String?        @unique @map("student_code")
  passwordHash     String         @map("password_hash")
  avatarUrl        String?        @map("avatar_url")
  school           String?
  major            String?
  courseYear       Int?           @map("course_year")
  timezone         String         @default("Asia/Ho_Chi_Minh")
  language         String         @default("vi")
  themeMode        ThemeMode      @default(light) @map("theme_mode")
  isEmailVerified  Boolean        @default(false) @map("is_email_verified")
  failedLoginCount Int            @default(0) @map("failed_login_count")
  lockedUntil      DateTime?      @map("locked_until")
  deletedAt        DateTime?      @map("deleted_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  roles            UserRole[]
  refreshTokens    RefreshToken[]
  semesters        Semester[]
  subjects         Subject[]

  @@index([email])
  @@index([studentCode])
  @@index([deletedAt])
  @@map("users")
}

/// Semesters use soft delete through deletedAt so historical study data can be restored
/// and dashboard/statistics can avoid accidental data loss.
model Semester {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  name            String
  academicYear    String         @map("academic_year")
  startDate       DateTime       @map("start_date") @db.Date
  endDate         DateTime       @map("end_date") @db.Date
  status          SemesterStatus @default(planning)
  targetGpa       Decimal?       @map("target_gpa") @db.Decimal(4, 2)
  expectedCredits Int?           @map("expected_credits")
  note            String?
  deletedAt       DateTime?      @map("deleted_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects        Subject[]

  @@unique([id, userId])
  @@index([userId, status])
  @@index([userId, deletedAt])
  @@map("semesters")
}

/// Subjects also use soft delete through deletedAt. The database migration adds a
/// partial unique index so a user cannot reuse the same subject code in one semester
/// while an active, non-deleted subject with that code still exists.
model Subject {
  id          String        @id @default(uuid()) @db.Uuid
  semesterId  String        @map("semester_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  code        String
  name        String
  credits     Int
  lecturer    String?
  room        String?
  colorHex    String        @map("color_hex")
  targetGrade Decimal?      @map("target_grade") @db.Decimal(4, 2)
  status      SubjectStatus @default(in_progress)
  note        String?
  deletedAt   DateTime?     @map("deleted_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  semester    Semester      @relation(fields: [semesterId, userId], references: [id, userId], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([semesterId, status])
  @@index([userId, deletedAt])
  @@map("subjects")
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
