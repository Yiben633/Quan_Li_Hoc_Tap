# Local Prisma runtime and migration connections.
DATABASE_URL=postgresql://studyflow:change_me_strong_password@localhost:55432/studyflow_dev?schema=public
DIRECT_URL=postgresql://studyflow:change_me_strong_password@localhost:55432/studyflow_dev?schema=public

# Neon production shape (examples only, never commit real credentials):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.ap-southeast-1.aws.neon.tech/studyflow?sslmode=require
# DIRECT_URL=postgresql://USER:PASSWORD@ep-example.ap-southeast-1.aws.neon.tech/studyflow?sslmode=require

# Seed defaults are safe for local development. Remote and production databases require explicit opt-in.
SEED_TARGET=development
ALLOW_REMOTE_SEED=false
ALLOW_PRODUCTION_SEED=false
SEED_CONFIRM=

# Optional backup/restore settings.
BACKUP_DIR=./backups
DB_SERVICE=db
COMPOSE_FILE=../docker-compose.yml
