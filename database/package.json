{
  "name": "studyflow-database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:init-auth": "prisma migrate dev --name init_auth",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:check:auth": "node scripts/check-auth-schema.mjs",
    "db:check:semester-subject": "node scripts/check-semester-subject-schema.mjs",
    "db:check:plan-task": "node scripts/check-plan-task-schema.mjs",
    "db:check:calendar-goal": "node scripts/check-calendar-goal-schema.mjs",
    "db:check:grade": "node scripts/check-grade-schema.mjs",
    "db:check:study-document-note": "node scripts/check-study-document-note-schema.mjs",
    "db:check:advanced": "node scripts/check-advanced-entities-schema.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
