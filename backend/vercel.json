{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "functions": {
    "api/index.ts": {
      "includeFiles": ["src/**"]
    }
  },
  "routes": [{ "src": "/(.*)", "dest": "api/index.ts" }],
  "crons": [{ "path": "/api/cron/notifications", "schedule": "0 0 * * *" }]
}
