NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://studyflow:change_me_strong_password@localhost:55432/studyflow_dev?schema=public
DIRECT_URL=postgresql://studyflow:change_me_strong_password@localhost:55432/studyflow_dev?schema=public
# Local Docker Redis. On Vercel use the Upstash TCP/TLS URL:
# rediss://default:<password>@<database>.upstash.io:6379
REDIS_URL=redis://:change_me_redis_password@localhost:6379
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_SECRET=replace_with_a_long_random_access_secret
REFRESH_TOKEN_SECRET=replace_with_a_long_random_refresh_secret
CLIENT_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Local defaults to lax. Two separate production domains use none + Secure.
COOKIE_SAME_SITE=lax
TRUST_PROXY=false
# Use a random value of at least 16 characters; 32+ is recommended.
CRON_SECRET=replace_with_a_random_cron_secret
DOCUMENT_MAX_UPLOAD_BYTES=20971520
# local | s3-compatible | disabled. Vercel falls back to disabled until cloud storage is configured.
STORAGE_PROVIDER=local
# Required when STORAGE_PROVIDER=s3-compatible. S3_ENDPOINT may be omitted for AWS S3.
S3_ENDPOINT=https://object-storage.example.com
S3_REGION=auto
S3_BUCKET=studyflow
S3_ACCESS_KEY_ID=replace_with_storage_access_key
S3_SECRET_ACCESS_KEY=replace_with_storage_secret_key
S3_PUBLIC_BASE_URL=https://cdn.example.com
S3_FORCE_PATH_STYLE=false
AI_PROVIDER=mock
# Select mock, openai, or gemini. Provider keys are backend-only and must never use a VITE_ prefix.
# Required only when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Required only when AI_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Maximum duration for one provider HTTP attempt. Gemini retries at most once.
AI_PROVIDER_TIMEOUT_MS=25000
# Cost controls. These limits apply before provider calls and are backend-only.
MAX_CONTEXT_TASKS=40
MAX_CONTEXT_EVENTS=40
AI_MAX_INPUT_CHARS=24000
AI_DAILY_REQUEST_LIMIT=50
# Backend-only secret required only while manually granting the initial administrator role.
# Set it temporarily, run npm run admin:bootstrap, then remove it from the runtime environment.
# Never expose it with a VITE_ prefix or use it to grant roles during login.
ADMIN_BOOTSTRAP_EMAIL=
